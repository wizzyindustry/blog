# ------------------------------------------------------------------
# Admin area
#
# WHO may open it is decided in PHP (enforce_admin_access() in includes/security.php),
# so the same rule works on XAMPP and on shared hosting:
#   ADMIN_ACCESS => 'local'   only this computer (default)
#   ADMIN_ACCESS => 'any'     anyone with the admin password (live hosting)
#   ADMIN_ACCESS => '41.59.10.20, 197.250.0.0/16'   only these addresses
# Everyone else gets "404 Not Found" before any admin page runs.
# ------------------------------------------------------------------

# Never cache admin pages or show them in search engines
<IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Helper templates are never opened directly
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^includes/ - [F,L]
</IfModule>
