# Open the landing page first when visiting the project folder
# (e.g. http://localhost/udom-blog). index.php remains the materials listing.
DirectoryIndex landing.php index.php

AddType application/manifest+json .webmanifest

# Hide folder listings
Options -Indexes

# Branded error screens (error.php). The path starts with the project folder: change "/blog"
# if the site is moved (e.g. to "/error.php" when installed at the web root).
ErrorDocument 400 /blog/error.php
ErrorDocument 401 /blog/error.php
ErrorDocument 403 /blog/error.php
ErrorDocument 404 /blog/error.php
ErrorDocument 405 /blog/error.php
ErrorDocument 408 /blog/error.php
ErrorDocument 413 /blog/error.php
ErrorDocument 500 /blog/error.php
ErrorDocument 502 /blog/error.php
ErrorDocument 503 /blog/error.php
ErrorDocument 504 /blog/error.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---- 1. Protocol: HTTP for now (the site is not live yet) ----
    # Every HTTPS request is sent back to plain HTTP. 302 = temporary, so browsers do not remember it.
    RewriteCond %{HTTPS} =on
    RewriteRule ^ http://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]

    # WHEN THE SITE GOES LIVE (with a real certificate): delete the 2 lines above, uncomment the
    # 2 lines below, and set FORCE_HTTP => false / FORCE_HTTPS => true in config/secrets.php.
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ---- robots.txt, sitemap.xml and llms.txt are generated by PHP (always up to date) ----
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^llms\.txt$ llms.php [L]

    # ---- 2. Internal folders are never served (404, so they are not even confirmed to exist) ----
    RewriteRule ^(config|includes|sql|logs|deploy)(/|$) - [R=404,L]
    RewriteRule ^RELEASE\.json$ - [R=404,L]
    RewriteRule ^(admin|account)/includes(/|$) - [R=404,L]

    # ---- 3. Dot-files (.git, .env, .gitignore) and docs / dumps / logs ----
    RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
    RewriteRule \.(md|sql|log|ini|bak|old|swp|dist|lock|example\.php)$ - [R=404,L,NC]
</IfModule>

# Fallback if mod_rewrite is not available
<IfModule !mod_rewrite.c>
    RedirectMatch 404 /(config|includes|sql|logs)/
    RedirectMatch 404 /\.(git|env)
    RedirectMatch 404 /(admin|account)/includes/
</IfModule>

# Security headers for EVERY response, including CSS, JS and images (PHP pages add a CSP too)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HTTP mode: max-age=0 makes browsers FORGET the earlier "HTTPS only for a year" rule.
    # When going live, change it back to: "max-age=31536000; includeSubDomains"
    Header always set Strict-Transport-Security "max-age=0" "expr=%{HTTPS} == 'on'"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# ---- Text compression (gzip): HTML, CSS, JS, JSON, XML, SVG and plain text ----
# Needs mod_deflate AND mod_filter (both enabled in C:\xampp\apache\conf\httpd.conf).
# style.css: 102 KB -> 17 KB. Without either module these lines are skipped (no 500 error).
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/markdown
        AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
        AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml application/manifest+json
        AddOutputFilterByType DEFLATE image/svg+xml image/x-icon image/vnd.microsoft.icon
    </IfModule>
    # File downloads stream exact bytes and support resuming (Range): never re-compress them
    SetEnvIfNoCase Request_URI "/(account/file|download)\.php$" no-gzip dont-vary
</IfModule>

# ---- Browser caching for static files (PHP pages are never cached: they send no-store) ----
<IfModule mod_headers.c>
    # CSS / JS are linked as style.css?v=<last-modified>: a new version gets a new URL, so cache for a year
    <FilesMatch "\.(css|js|mjs|woff2?|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Post images and avatars get a new random file name when replaced: 30 days
    <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|bmp)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # Favicons and the web manifest keep their names: 1 week
    <FilesMatch "\.(ico|webmanifest)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# PHP: never display errors to visitors (also enforced in includes/security.php)
<IfModule php_module>
    php_flag display_errors Off
    php_flag display_startup_errors Off
    php_flag session.cookie_httponly On
    php_flag session.use_strict_mode On
    php_flag session.use_only_cookies On
</IfModule>
